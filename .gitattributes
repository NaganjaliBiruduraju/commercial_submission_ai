# Normalize line endings to LF in the repository
# Windows developers will get CRLF checkouts, repository stores LF
* text=auto eol=lf

# Python — always LF
*.py text eol=lf
*.pyi text eol=lf

# Web / config
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.env.example text eol=lf
*.gitignore text eol=lf

# Binary files — no line ending conversion
*.pdf binary
*.docx binary
*.xlsx binary
*.xls binary
*.png binary
*.jpg binary
*.jpeg binary
