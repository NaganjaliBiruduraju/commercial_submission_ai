# =============================================================================
# INSIGHT AI — Environment Variable Configuration
# =============================================================================
#
# INSTRUCTIONS:
#   1. Copy this file to .env  (which is git-ignored)
#   2. Fill in EVERY value before running the application
#   3. NEVER commit .env to version control
#   4. NEVER share these values in chat, screenshots, or code reviews
#   5. Generate SECRET_KEY with: openssl rand -hex 32
#
# This file is safe to commit — it contains NO real credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE
# PostgreSQL connection string (asyncpg driver for async FastAPI)
# Format: postgresql+asyncpg://user:password@host:port/dbname
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://insight_user:CHANGE_ME@localhost:5432/insight_ai

# Database pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# -----------------------------------------------------------------------------
# AUTHENTICATION
# Generate SECRET_KEY with: openssl rand -hex 32
# This signs all JWT tokens — treat it like a password
# -----------------------------------------------------------------------------
SECRET_KEY=GENERATE_WITH_openssl_rand_-hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# LLM — GROQ API
# IMPORTANT: Never put your actual API key in this file.
# Configure GROQ_API_KEY in your .env file only.
# The key is loaded server-side. The frontend NEVER receives this key.
# -----------------------------------------------------------------------------
GROQ_API_KEY= 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

# LLM Model configuration
LLM_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE_EXTRACTION=0.1
LLM_TEMPERATURE_SUMMARIZATION=0.3
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# EMBEDDINGS
# Used for RAG vector search — sentence-transformers runs locally (free)
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
APP_ENV=development
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
APP_NAME=INSIGHT AI
APP_VERSION=1.0.0

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# INITIAL ADMIN USER (first-run seeding only)
# Set these BEFORE first startup. The admin user is created if no admin exists.
# Change the password immediately after first login.
# NEVER commit real credentials here.
# -----------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL=admin@insightai.local
INITIAL_ADMIN_PASSWORD=CHANGE_ME_IMMEDIATELY

# -----------------------------------------------------------------------------
# FILE UPLOAD
# -----------------------------------------------------------------------------
# Directory where uploaded files are stored (outside web root)
UPLOAD_DIR=./data/uploads
# Maximum file size in megabytes (server-side enforcement)
MAX_UPLOAD_SIZE_MB=50
# Maximum number of files per submission
MAX_FILES_PER_SUBMISSION=20
# Allowed file extensions (comma-separated, no dots)
ALLOWED_EXTENSIONS=pdf,docx,xlsx,csv,jpg,jpeg,png

# -----------------------------------------------------------------------------
# OCR — Tesseract
# Install: https://github.com/UB-Mannheim/tesseract/wiki (Windows)
#          apt-get install tesseract-ocr (Linux)
#          brew install tesseract (Mac)
# Leave blank if tesseract is on PATH.
# -----------------------------------------------------------------------------
TESSERACT_CMD=

# -----------------------------------------------------------------------------
# RISK SCORING — CONFIGURABLE THRESHOLDS
# These are placeholder demo values.
# Real thresholds must be approved by a licensed underwriting authority.
# Mark as [CONFIGURATION REQUIRED] until officially approved.
# -----------------------------------------------------------------------------
RISK_LOW_MAX=39
RISK_MEDIUM_MAX=69
RISK_HIGH_MIN=70
RISK_BASE_SCORE=50

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
# Set to a file path to write logs to disk, or leave empty for stdout
LOG_FILE=

# -----------------------------------------------------------------------------
# FRONTEND (build-time variables — no secrets here)
# These are injected at Vite build time and visible in the browser bundle.
# NEVER put API keys, secrets, or backend credentials here.
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=INSIGHT AI
VITE_APP_ENV=development
